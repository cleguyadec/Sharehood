# ═══════════════════════════════════════════════════════════
#  Sharehood — Configuration Apache
# ═══════════════════════════════════════════════════════════

# Désactiver l'affichage des répertoires
Options -Indexes

# Masquer la version du serveur
ServerSignature Off

# ── Bloquer l'accès direct aux fichiers sensibles ──────────
<FilesMatch "^(config|functions)\.php$">
    Require all denied
</FilesMatch>

# Désactiver install.php après installation (décommenter) :
# <Files "install.php">
#     Require all denied
# </Files>

# ── En-têtes de sécurité HTTP ─────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # Supprimer les en-têtes qui révèlent la stack technique
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ── Cache statique (fonts Google chargées via CDN, rien à cacher ici) ─
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

# ── Forcer HTTPS si disponible ─────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Décommenter pour forcer HTTPS :
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
